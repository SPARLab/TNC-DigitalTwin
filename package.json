{
  "name": "dangermond-preserve-data-catalog",
  "version": "1.0.0",
  "description": "A React TypeScript application for browsing and visualizing environmental research data from the Dangermond Preserve",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-standalone-experiences.mjs --if-missing --warn-on-failure && vite",
    "build": "npm run build:standalone-experiences && tsc && vite build",
    "build:standalone-experiences": "node scripts/build-standalone-experiences.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "guard:v2-file-size": "node scripts/v2/check-file-size-guardrail.mjs",
    "test": "vitest --project app",
    "test:ui": "vitest --ui --project app",
    "test:run": "vitest run --project app",
    "test:coverage": "vitest run --coverage --project app",
    "test:e2e": "playwright test --config=playwright.legacy-e2e.config.ts",
    "test:e2e:ui": "playwright test --config=playwright.legacy-e2e.config.ts --ui",
    "test:e2e:smoke": "playwright test --config=playwright.legacy-e2e.config.ts --grep='Smoke Tests'",
    "test:e2e:report": "playwright show-report",
    "test:e2e:generate-data": "tsx e2e/scripts/parse-manual-test-csv.ts",
    "test:e2e:checkpoint": "playwright test --config=playwright.checkpoint.config.ts",
    "test:e2e:validate": "tsx e2e/scripts/validate-tests.ts",
    "test:e2e:progress": "tsx e2e/scripts/progress-report.ts",
    "test:fast-only": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-runner.ts fast-only",
    "test:features": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-runner.ts features",
    "test:core": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-runner.ts core",
    "test:shared": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-runner.ts shared",
    "test:browser-deterministic": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-runner.ts browser-deterministic",
    "test:browser-live": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-runner.ts browser-live",
    "test:refresh-map-cache": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-runner.ts refresh-map-cache",
    "test:browser-all": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-runner.ts browser-all",
    "test:browser-only": "npm run test:browser-all",
    "test:gate": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-runner.ts gate",
    "test:all": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-runner.ts all",
    "test:view-test-catalog": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/view-test-catalog.mjs",
    "test:feature": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-runner.ts feature",
    "test:feature-set": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-runner.ts feature-set",
    "test:id": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-runner.ts id"
  },
  "dependencies": {
    "@arcgis/core": "^4.33.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/jszip": "^3.4.0",
    "dompurify": "^3.4.15",
    "echarts": "^6.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.555.0",
    "nodemailer": "^10.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jsdom": "^27.0.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.0.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
